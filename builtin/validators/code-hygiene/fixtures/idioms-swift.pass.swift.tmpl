/// A `for` loop, which `preferForLoop` asks for.
public func walk(_ names: [String]) {
    for name in names {
        print(name)
        print(name.count)
    }
}

/// The shape the enum of the pattern group binds.
public enum Shape {
    case circle(Int)
    case square(Int, Int)
}

/// A `let` binding on each case variable, which `hoistPatternLet` asks for
/// under `--pattern-let inline`.
public func describe(_ shape: Shape) -> String {
    switch shape {
    case .circle(let radius):
        return "circle \(radius)"
    case .square(let width, let height):
        return "square \(width)x\(height)"
    }
}

/// A `final` class, which `preferFinalClasses` asks for.
