/// A suite with no redundant `@Suite`, which `redundantSwiftTestingSuite`
/// asks for.
struct ReadingsTests {
    /// A raw-identifier name, which `swiftTestingTestCaseNames` asks for, on
    /// an internal test method, which `testSuiteAccessControl` asks for.
    @Test func `readings hold their values`() {
        #expect(Readings.hasNone([]))
    }

    /// A `throws` test rather than a `try!`, which `noForceTryInTests` asks
    /// for.
    @Test func `readings load`() throws {
        try Readings.load()
    }

    /// A `#require` rather than a force unwrap, which `noForceUnwrapInTests`
    /// asks for.
    @Test func `the smallest reading stands`() throws {
        let value = try #require(Readings.smallest([1]))
        #expect(value == 1)
    }

    /// A private helper, which `testSuiteAccessControl` asks for, named so
    /// that `validateTestCases` reads no test in it.
    private func stagedReadings() -> [Int] {
        [1, 2, 3]
    }
}
