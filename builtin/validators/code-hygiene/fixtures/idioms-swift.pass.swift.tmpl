// The passing fixture of the `idioms-swift` tool rule.
//
// It holds the same declarations the failing fixture holds, each written in
// the form its rule asks for, so the gate must report none of them.

// MARK: - AlwaysUseLiteralForEmptyCollectionInit

/// Empty collections declared with an annotated literal, which
/// `AlwaysUseLiteralForEmptyCollectionInit` asks for.
public struct Holder {
    /// The readings the holder holds.
    public var items: [Int] = []

    /// The readings the holder holds by name.
    public var table: [String: Int] = [:]
}

// MARK: - UseShorthandTypeNames

/// Shorthand generic type names, which `UseShorthandTypeNames` asks for.
public enum Sugar {
    /// How many readings the array holds.
    public static func read(_ values: [Int]) -> Int {
        values.count
    }

    /// How many readings the table holds.
    public static func table(_ pairs: [String: Int]) -> Int {
        pairs.count
    }

    /// How many letters the name holds.
    public static func name(_ value: String?) -> Int {
        value?.count ?? 0
    }
}

// MARK: - NoVoidReturnOnFunctionSignature

/// Signatures with no return clause at all, which
/// `NoVoidReturnOnFunctionSignature` asks for.
public enum Returns {
    /// A run that answers nothing.
    public static func run() {}

    /// A second run that answers nothing.
    public static func typed() {}
}

// MARK: - UseSynthesizedInitializer

/// A type that lets the compiler synthesize its memberwise initializer, which
/// `UseSynthesizedInitializer` asks for.
public struct Reading {
    /// How many readings stand.
    public var count: Int
}

// MARK: - ReplaceForEachWithForLoop

/// A `for` loop, which `ReplaceForEachWithForLoop` asks for.
public enum Looping {
    /// Writes each reading over the limit.
    public static func walk(_ things: [Int]) {
        for thing in things where thing > 2 { print(thing) }
    }
}

// MARK: - UseLetInEveryBoundCaseVariable

/// The shape the pattern below binds.
public enum Corner {
    /// A corner at two readings.
    case at(Int, Int)
}

/// A `let` on each bound case variable, which
/// `UseLetInEveryBoundCaseVariable` asks for.
public func describe(_ corner: Corner) -> Int {
    switch corner {
    case .at(let x, let y):
        return x + y
    }
}

// MARK: - DontRepeatTypeInStaticProperties

/// A static member whose name states no type name, which
/// `DontRepeatTypeInStaticProperties` asks for.
public struct Color {
    /// The red color.
    public static let red = Color()
}
