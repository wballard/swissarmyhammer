// MARK: - The performance group

public enum Readings {
    /// `count(where:)`, which `preferCountWhere` asks for.
    public static func overLimit(_ values: [Int]) -> Int {
        values.count(where: { $0 > 10 })
    }

    /// `isEmpty`, which `isEmpty` asks for.
    public static func hasNone(_ values: [Int]) -> Bool {
        values.isEmpty
    }

    /// `contains(where:)`, which `preferContains` asks for.
    public static func holds(_ values: [Int]) -> Bool {
        values.contains(where: { $0 == 3 })
    }

    /// `first(where:)`, which `preferFirstWhere` asks for.
    public static func firstOver(_ values: [Int]) -> Int? {
        values.first(where: { $0 > 10 })
    }

    /// `min()`, which `preferMinOverSorted` asks for.
    public static func smallest(_ values: [Int]) -> Int? {
        values.min()
    }

    /// `flatMap { }`, which `preferFlatMap` asks for.
    public static func flattened(_ sections: [[Int]]) -> [Int] {
        sections.flatMap { $0 }
    }

    /// The reading a forced call of the failing fixture stands in for.
    public static func load() throws {}
}

