// The failing fixture of the `idioms-swift` tool rule.
//
// One declaration stands for each rule of the gate allowlist, and each one is
// written in the form its rule reports.

// MARK: - AlwaysUseLiteralForEmptyCollectionInit

/// Empty collections declared with a call, which
/// `AlwaysUseLiteralForEmptyCollectionInit` reports.
public struct Holder {
    /// The readings the holder holds.
    public var items = [Int]()

    /// The readings the holder holds by name.
    public var table = [String: Int]()
}

// MARK: - UseShorthandTypeNames

/// Long-form generic type names, which `UseShorthandTypeNames` reports.
public enum Sugar {
    /// How many readings the array holds.
    public static func read(_ values: Array<Int>) -> Int {
        values.count
    }

    /// How many readings the table holds.
    public static func table(_ pairs: Dictionary<String, Int>) -> Int {
        pairs.count
    }

    /// How many letters the name holds.
    public static func name(_ value: Optional<String>) -> Int {
        value?.count ?? 0
    }
}

// MARK: - NoVoidReturnOnFunctionSignature

/// Return clauses that state the empty tuple and `Void`, which
/// `NoVoidReturnOnFunctionSignature` reports in both halves.
public enum Returns {
    /// A run that answers nothing, with the empty tuple stated.
    public static func run() -> () {}

    /// A run that answers nothing, with `Void` stated.
    public static func typed() -> Void {}
}

// MARK: - UseSynthesizedInitializer

/// An internal memberwise initializer the compiler would synthesize, which
/// `UseSynthesizedInitializer` reports.
public struct Reading {
    /// How many readings stand.
    public var count: Int

    init(count: Int) {
        self.count = count
    }
}

// MARK: - ReplaceForEachWithForLoop

/// A `forEach` call, which `ReplaceForEachWithForLoop` reports.
public enum Looping {
    /// Writes each reading over the limit.
    public static func walk(_ things: [Int]) {
        things.forEach { if $0 > 2 { print($0) } }
    }
}

// MARK: - UseLetInEveryBoundCaseVariable

/// The shape the pattern below binds.
public enum Corner {
    /// A corner at two readings.
    case at(Int, Int)
}

/// A `let` that binds the whole pattern, which
/// `UseLetInEveryBoundCaseVariable` reports.
public func describe(_ corner: Corner) -> Int {
    switch corner {
    case let .at(x, y):
        return x + y
    }
}

// MARK: - DontRepeatTypeInStaticProperties

/// A static member whose name repeats the name of its own type, which
/// `DontRepeatTypeInStaticProperties` reports.
public struct Color {
    /// The red color.
    public static let redColor = Color()
}
